{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCast Studio",
  "identifier": "ru.vrcast.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ffmpeg && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRCast Studio",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "VRCast",
    "homepage": "https://github.com/Delave-las-Kure/vrcast",
    "category": "Video",
    "licenseFile": "../LICENSE",
    "copyright": "VRCast Studio, GPL-3.0-or-later",
    "shortDescription": "Управление сервером, с которого раздаются видео в VRChat",
    "longDescription": "Библиотека, подготовка файлов, заливка с продолжением после обрыва, зрители, ограничения качества, развёртывание сервера и диагностика. Работает с любым VPS: адрес, домен и пути берутся из профиля, который заводит пользователь.",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
