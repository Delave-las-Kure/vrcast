# --- VRCast Studio ---
# Локальная база и данные приложения
*.sqlite
*.sqlite-journal
*.db

# Эталон проверки изоляции — локальный, у каждого свой
.isolation-baseline

# Никаких секретов в репозитории (конституция, принцип IV).
# server.env лежит ВНЕ этого репозитория и физически не может быть закоммичен,
# но перестраховываемся на случай копии.
server.env
*.pem
*.key
id_*
!src/**/key*.ts

# Ключ для одноразового контейнера создаётся при первом запуске интеграционных
# тестов (tests/integration/fixture.rs) и живёт только на этой машине. Открытая
# часть здесь тоже лишняя: без приватной она бесполезна, а пара файлов с такими
# именами в общедоступном репозитории только настораживает.
src-tauri/tests/fixtures/encrypted_ed25519.key.pub
src-tauri/tests/fixtures/docker/encrypted_ed25519.key.pub

# Вложенный FFmpeg: сто шестьдесят мегабайт чужих исполняемых файлов, которые
# кладутся при сборке (scripts/fetch-ffmpeg.mjs). В репозитории им не место —
# они не наш исходный код, а закреплены слепком в scripts/ffmpeg.json.
src-tauri/binaries/

# Кроме записанного сеанса, на котором стоит разбор подвисаний (T311): это оснастка, а не
# чей-то журнал. Правило стоит последним намеренно — git берёт последнее совпавшее, и то же
# самое строкой выше не отменяло бы `*.log`. Без неё сборка падает у всех, кроме того, кто
# оснастку написал, и падает в CI, где непонятно, что искать.
!src-tauri/tests/fixtures/logs/
!src-tauri/tests/fixtures/logs/*.log
